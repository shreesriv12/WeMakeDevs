FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production
ENV REALTIME_PORT=3003

# tsx executes the small TypeScript realtime entrypoint at runtime.
COPY package.json package-lock.json ./
RUN npm ci --include=dev --no-audit --no-fund
COPY lib ./lib
COPY realtime ./realtime

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 realtime
USER realtime
EXPOSE 3003
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD node -e "fetch('http://127.0.0.1:3003/socket.io/?EIO=4&transport=polling').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
CMD ["node", "--import", "tsx", "realtime/server.ts"]
