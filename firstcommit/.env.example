# Server-only. Do not use NEXT_PUBLIC_ for secret values.
SERPAPI_API_KEY=
# Comma-separated allowlist. An empty list disables external web research.
SERPAPI_ALLOWED_DOMAINS=ncert.nic.in,ugc.gov.in

# AWS: use IAM roles in deployed environments; do not add AWS access keys here.
AWS_REGION=us-east-1
# Public identifiers only; required for the browser Cognito sign-in screen.
NEXT_PUBLIC_AWS_REGION=us-east-1
COURSE_CONTENT_BUCKET=
BEDROCK_TUTOR_MODEL_ID=
# Opt-in only: generates varied course-grounded interview prompts; deterministic note questions remain the fallback.
ENABLE_BEDROCK_INTERVIEW_GENERATION=false
BEDROCK_INTERVIEW_MODEL_ID=
INTERVIEW_GENERATION_PROVIDER=deterministic
INTERVIEW_ANSWER_EVALUATOR=deterministic
# Optional premium interview voice providers. Keep API keys server-only.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENROUTER_API_KEY=
OPENROUTER_INTERVIEW_MODEL=meta-llama/llama-3.3-70b-instruct
SAGEMAKER_INTENT_ENDPOINT=
# Keep disabled until the Deep Knowledge Tracing model beats the historical baseline on real consented data.
SAGEMAKER_MASTERY_ENDPOINT=
ENABLE_SAGEMAKER_MASTERY=false
# Enables production course retrieval through Bedrock Knowledge Bases.
BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_KNOWLEDGE_BASE_DATA_SOURCE_ID=

# Cognito access-token verification. Local demo access is opt-in only.
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=
ALLOW_DEMO_IDENTITY=true
# Only honored with ALLOW_DEMO_IDENTITY=true. Use student or teacher locally.
DEMO_ROLE=student

# Local PostgreSQL (started with: docker compose up -d db)
DATABASE_URL=postgresql://shikshamesh:shikshamesh_dev_password@localhost:5433/shikshamesh
# Required only by the admin-only mastery-training CSV export. Keep this secret out of source control.
ML_PSEUDONYMIZATION_SALT=
# Step Functions state machine for quiz -> translation -> schedule -> analytics.
QUIZ_WORKFLOW_STATE_MACHINE_ARN=
# Optional custom EventBridge bus for privacy-safe audit events.
AUDIT_EVENT_BUS_NAME=


# Qdrant vector database.
# Local Docker:
# QDRANT_URL=http://127.0.0.1:6333
#
# Production:
# QDRANT_URL=https://your-qdrant-cluster-url
QDRANT_URL=

# Server-only Qdrant API key.
QDRANT_API_KEY=

# Vector collection for uploaded course chunks.
QDRANT_COLLECTION=shikshamesh-course-chunks

# OpenRouter is used for document/query embeddings.
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
REALTIME_PORT=3003
NEXT_PUBLIC_REALTIME_URL=http://localhost:3003
# Production only: exact public origin of the Next.js application, for example https://app.example.com.
REALTIME_ALLOWED_ORIGIN=
# Set to production only in deployed environments. The health endpoint reports unsafe production settings.
DEPLOYMENT_ENV=development

# Amazon IVS Real-Time WebRTC. Keep disabled until a stage has been created.
# The server uses its IAM role to issue short-lived, stage-scoped participant tokens.
ENABLE_IVS_REALTIME=false
IVS_REALTIME_STAGE_ARN=
